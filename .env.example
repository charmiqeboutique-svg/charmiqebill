# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PostgreSQL connection string (Required).
# For Neon DB (Free serverless PostgreSQL from https://neon.tech):
DATABASE_URL="postgresql://username:password@ep-xyz-123.us-east-2.aws.neon.tech/neondb?sslmode=require"
PGSSLMODE="require"

# For local PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/charmiqe_pos"
# PGSSLMODE="disable"
